---
layout: layouts/base.njk
house: true
pagination:
  data: floors
  size: 1
  alias: floor
permalink: "{{ floor.url }}.html"
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ floor.name }}"
  description: "{{ floor.description }}"
---
{%- set F = collections.house.byKey[floor.key] -%}
{%- set i = pagination.pageNumber -%}
<div class="wrap floor-page floor-{{ floor.key }}">
  <div class="title mono"><span>FLOOR PLAN · SECTION A–A</span><span>SCALE 1:50</span></div>
  <header class="fl-head">
    <div class="h"><b>{{ floor.room }}</b></div>
    <h1>{{ floor.name }}</h1>
    <p class="blurb">{{ floor.blurb }}</p>
    <p class="count mono">{{ F.count }} {{ 'item' if F.count == 1 else 'items' }}</p>
  </header>
  {%- if F.count %}
  <ul class="grid">
    {%- for it in F.items %}
    <li class="cell">
      <a class="thumb" href="{{ it.url }}" tabindex="-1" aria-hidden="true">{% if it.image %}<img src="{{ it.image }}" alt="" sizes="(max-width: 700px) 50vw, 25vw" loading="lazy"{% if it.focus %} style="object-position:{{ it.focus }}"{% elif it.kind == 'project' %} style="object-position:0 0"{% endif %}>{% else %}<span class="blank">{{ it.tag }}</span>{% endif %}</a>
      <div class="meta">
        <h2><a href="{{ it.url }}">{{ it.title }}</a>{% if it.lang == 'it' %} <span class="it">IT</span>{% endif %}</h2>
        {%- if it.date %}<p class="when mono">{{ it.date.getUTCFullYear() }}</p>{% endif %}
        {%- if it.desc %}<p class="desc">{{ it.desc }}</p>{% endif %}
      </div>
    </li>
    {%- endfor %}
  </ul>
  {%- else %}
  <p class="empty">Nothing here yet.</p>
  {%- endif %}
  <nav class="stairs" aria-label="Other floors">
    {%- if i > 0 %}<a class="up" href="{{ floors[i - 1].url }}">↑ {{ floors[i - 1].name }}</a>{% endif %}
    <a class="house" href="/">The whole house</a>
    {%- if i < floors.length - 1 %}<a class="down" href="{{ floors[i + 1].url }}">↓ {{ floors[i + 1].name }}</a>{% endif %}
  </nav>
</div>
