---
permalink: /post/rss.xml
eleventyExcludeFromCollections: true
---
{%- set origin = build.origin -%}
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ "Blog — " + site.name | xmlEscape }}</title>
    <link>{{ origin }}/post</link>
    <description>{{ site.blog_description | xmlEscape }}</description>
    <language>en</language>
    <atom:link href="{{ origin }}/post/rss.xml" rel="self" type="application/rss+xml" />
    {%- for p in collections.posts | notDuplicate | limit(20) %}
    <item>
      <title>{{ p.data.title | xmlEscape }}</title>
      <link>{{ origin }}{{ p.url | cleanUrl }}</link>
      <guid isPermaLink="true">{{ origin }}{{ p.url | cleanUrl }}</guid>
      <pubDate>{{ p.date | dateRFC822 }}</pubDate>
      <description>{{ p.data.excerpt | mdBlock | xmlEscape }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
