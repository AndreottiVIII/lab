---
layout: layouts/base.njk
house: true
---
{%- set H = collections.house -%}
<script>if(location.pathname==='{{ '/index' | url }}')location.replace('{{ '/blog-index' | url }}');</script>
<div class="wrap sheet">
  <div class="draw">
    <div class="title mono"><span>SECTION A–A</span><span>SCALE 1:50</span></div>
    {% houseDrawing H %}
  </div>
  <aside class="key" aria-label="The house, floor by floor">
    <p class="intro">Scroll down the house, from the greenhouse to the darkroom. <em>Every number is something to open.</em></p>
    {%- for f in H.floors %}
    <section class="fl{% if f.key == 'photography' %} dark{% endif %}" id="{{ f.key }}">
      <div class="h"><b>{{ f.room }}</b><span>{{ f.level }}</span></div>
      <h2><a href="{{ f.url }}">{{ f.name }} <small>enter →</small></a></h2>
      <ol>
        {%- for it in f.shown %}
        <li{% if it.dev %} data-dev-for="{{ it.dev }}"{% endif %}><i>{{ it.n }}</i><a href="{{ it.url }}">{{ it.title }}</a>{% if it.lang == 'it' %} <span class="it">IT</span>{% endif %}</li>
        {%- endfor %}
        {%- if f.pegN %}
        <li class="peg"><i>{{ f.pegN }}</i>On the pegboard: {% for p in f.pegItems %}<a href="{{ p.url }}">{{ p.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% if f.more %} and <a href="{{ f.url }}">{{ f.more }} more →</a>{% endif %}</li>
        {%- elif f.more %}
        <li class="more"><a href="{{ f.url }}">and {{ f.more }} more →</a></li>
        {%- endif %}
        {%- if not f.count %}
        <li class="empty">Nothing here yet.</li>
        {%- endif %}
      </ol>
    </section>
    {%- endfor %}
    <div class="block"><div><b>Davide Caniatti</b>drawing</div><div><b>A–A</b>section</div><div><b>1:50</b>scale</div><div><b>Milan</b>place</div><a href="/contact-davidecaniatti"><b>About</b>contact</a><div><b>01</b>sheet</div></div>
  </aside>
</div>
