{%- set origin = build.origin -%}
{%- set pageUrl = canonical or (page.url | cleanUrl) -%}
{%- set fullTitle = headTitle or ((seo_title or title) + " — " + site.name) -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ fullTitle }}</title>
{%- if build.mockup or noindex %}
<meta name="robots" content="noindex, nofollow">
{%- endif %}
{%- if description %}
<meta name="description" content="{{ description }}">
{%- endif %}
{%- if redirect_to %}
<meta http-equiv="refresh" content="0; url={{ redirect_to }}">
{%- endif %}
<link rel="canonical" href="{{ pageUrl | absUrl(site.url) }}">
<link rel="icon" href="/img/favicon.png">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/post/rss.xml">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ fullTitle }}">
<meta property="og:url" content="{{ pageUrl | absUrl(site.url) }}">
<meta property="og:type" content="website">
{%- if description %}
<meta property="og:description" content="{{ description }}">
{%- endif %}
{#- immagine per le condivisioni: la copertina dell'articolo, se no la prima foto della galleria, se no la scheda della casa (img/share.jpg) -#}
{%- set shareImg = cover or (gallery[0].image if gallery and gallery[0] and not maintenance) or "/img/share.jpg" -%}
<meta property="og:image" content="{{ origin }}{{ shareImg }}">
{%- if shareImg == "/img/share.jpg" %}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Davide Caniatti: the house in section, from the greenhouse to the darkroom">
{%- elif cover_alt %}
<meta property="og:image:alt" content="{{ cover_alt }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="/fonts/jost-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/house.css">
<script>window.SITE={mockup:{{ 'true' if build.mockup else 'false' }}{% if not build.mockup %},gaId:"{{ site.ga_id }}"{% endif %}};</script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<a class="skip-link" href="#page">Skip to Content</a>
{% include "house-header.njk" %}
<main id="page">
{{ content | safe }}
</main>
{% include "house-footer.njk" %}
{% include "cookie.njk" %}
<script src="/assets/js/site.js" defer></script>
{%- if house %}
<script src="/assets/js/house.js" defer></script>
{%- endif %}
</body>
</html>
