{%- set here = page.url | cleanUrl -%}
<header class="hh wrap{% if here == '/' %} is-home{% endif %}">
  {%- if build.lab %}<span class="lab-badge" title="Laboratorio: non è il sito vero">LAB</span>{% endif %}
  {% if here == '/' %}<h1 class="logo">Davide Caniatti</h1>{% else %}<a class="logo" href="/">Davide Caniatti</a>{% endif %}
  <nav aria-label="Main">
    {%- for f in floors %}
    <a class="fl-link k-{{ f.key }}" href="{{ f.url }}"{% if here == f.url %} aria-current="page"{% endif %}>{{ f.name }}<span><em>{{ f.room | lower }}</em></span></a>
    {%- endfor %}
    {%- if letters.url %}
    <a class="k-letters" href="{{ letters.url }}" target="_blank" rel="noopener">{{ letters.label }}<span><em>substack ↗</em></span></a>
    {%- endif %}
    <a class="k-about" href="/contact-davidecaniatti"{% if here == '/contact-davidecaniatti' %} aria-current="page"{% endif %}>About<span><em>contact</em></span></a>
  </nav>
</header>
