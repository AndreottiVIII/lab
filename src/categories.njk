---
layout: layouts/base.njk
pagination:
  data: collections.categoryList
  size: 1
  alias: category
permalink: "{{ category.name | categoryFile | safe }}"
eleventyExcludeFromCollections: true
eleventyComputed:
  headTitle: "{{ category.name | safe }} — Blog — Davide Caniatti"
  canonical: "{{ category.name | categoryUrl }}"
  description: "{{ category | listDesc('category') | safe }}"
---
{%- set kind = 'category' -%}
{%- set activeName = category.name -%}
{%- set items = category.posts -%}
{%- set firstNo = items.length -%}
{% include "register.njk" %}
  <nav class="stairs" aria-label="Other pages">
    <a class="up" href="/post"><span class="lbl">↑ up</span>Blog</a>
    <a class="whole" href="/">The whole house</a>
    <a class="down" href="/writing"><span class="lbl">↓ down</span>Writing</a>
  </nav>
</div>
