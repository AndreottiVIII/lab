---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{%- set origin = build.origin -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ origin }}/</loc></url>
  <url><loc>{{ origin }}/post</loc></url>
  {%- for f in floors %}
  <url><loc>{{ origin }}{{ f.url }}</loc></url>
  {%- endfor %}
  {%- for p in collections.posts %}
  <url><loc>{{ origin }}{{ p.url | cleanUrl }}</loc><lastmod>{{ p.date | dateISO }}</lastmod></url>
  {%- endfor %}
  {%- for c in collections.categoryList %}
  <url><loc>{{ origin }}{{ c.name | categoryUrl | xmlEscape }}</loc></url>
  {%- endfor %}
  {%- for t in collections.tagList %}
  <url><loc>{{ origin }}{{ t.name | tagUrl | xmlEscape }}</loc></url>
  {%- endfor %}
  {%- for g in collections.house.byKey.photography.items %}
  <url><loc>{{ origin }}{{ g.url }}</loc></url>
  {%- endfor %}
  {%- if letters.page %}
  <url><loc>{{ origin }}{{ letters.page }}</loc></url>
  {%- endif %}
  {%- if not build.lab %}
  <url><loc>{{ origin }}/appalti/</loc></url>
  {%- endif %}
  <url><loc>{{ origin }}/blog-index</loc></url>
  <url><loc>{{ origin }}/contact-davidecaniatti</loc></url>
</urlset>
