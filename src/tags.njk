---
layout: layouts/base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "{{ tag.name | tagFile | safe }}"
eleventyExcludeFromCollections: true
eleventyComputed:
  headTitle: "{{ tag.name | safe }} — Blog — Davide Caniatti"
  canonical: "{{ tag.name | tagUrl }}"
  description: "{{ tag | listDesc('tag') | safe }}"
---
{%- set kind = 'tag' -%}
{%- set activeName = tag.name -%}
{%- set items = tag.posts -%}
{%- set firstNo = items.length -%}
{% include "register.njk" %}
  <nav class="stairs" aria-label="Other pages">
    <a class="up" href="/post"><span class="lbl">↑ up</span>Blog</a>
    <a class="whole" href="/">The whole house</a>
    <a class="down" href="/writing"><span class="lbl">↓ down</span>Writing</a>
  </nav>
</div>
